---
import { projects } from "../../data/projects";
import SeoHead from "../../components/SeoHead.astro";
const pageTitle = "Matt McGowan Case Studies | AI Spend, Ops and Scale";
const pageDescription = "Case studies from Matt McGowan: AI spend cut from $20M to $12M annualized, maintenance windows from three weekends to one day and time to restore cut 75%.";
---
<!doctype html>
<html lang="en"><head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><SeoHead title={pageTitle} description={pageDescription} path="/projects/" pageType="CollectionPage" /><link rel="stylesheet" href="/assets/styles/main.css" /></head>
<body><header class="site-header page-shell"><div class="topbar"><a class="brand" href="/" aria-label="MattMcG / Lethal Coffee home">MattMcG / Lethal Coffee</a><nav class="top-links" aria-label="Primary"><a href="/about/">About</a><a href="/projects/" aria-current="page">Projects</a><a href="/#ventures">Ventures</a><a href="/connect/">Connect</a><a href="https://app.reclaim.ai/m/nullornan/lets-talk" target="_blank" rel="noopener noreferrer">Book a free call</a></nav></div></header>
<main class="page-shell project-index"><header class="page-intro"><p class="eyebrow">Selected work</p><h1>Systems that hold when it matters.</h1><p>Selected work from client engagements and operating roles. Each case study covers the problem, the approach and what changed.</p></header><div class="project-list">{projects.map((project) => <a class="project-list-item" href={`/projects/${project.slug}/`}><span class="project-number">{project.number}</span><span class="project-list-copy"><span class="project-list-title">{project.title}</span><span>{project.summary}</span></span><span class="project-outcome">{project.outcome}</span></a>)}</div><div class="hero-actions"><a class="button button-primary" href="https://app.reclaim.ai/m/nullornan/lets-talk" target="_blank" rel="noopener noreferrer">Book a free 30-minute call -&gt;</a><a class="text-link" href="https://nullornan.com" target="_blank" rel="noopener noreferrer">Work with NullorNaN -&gt;</a></div></main>
<footer class="site-footer page-shell"><p>Matt McGowan · 2026 · Atlanta Metro / US Southeast</p><div><a href="https://nullornan.com" target="_blank" rel="noopener noreferrer">nullornan.com</a><a href="https://www.linkedin.com/in/matthewcmcgowan" target="_blank" rel="noopener noreferrer">LinkedIn</a><a href="https://github.com/NullOrNaN" target="_blank" rel="noopener noreferrer">GitHub</a><a href="https://reliabilitylounge.com" target="_blank" rel="noopener noreferrer">Reliability Lounge</a><a href="https://app.reclaim.ai/m/nullornan/lets-talk" target="_blank" rel="noopener noreferrer">Book a free 30-minute call</a></div></footer></body></html>
