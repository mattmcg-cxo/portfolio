---
import { projects } from "../../data/projects";
import SeoHead from "../../components/SeoHead.astro";
export function getStaticPaths() { return projects.map((project) => ({ params: { slug: project.slug }, props: { project } })); }
const { project } = Astro.props;
const pageTitle = `${project.title} | Matt McGowan`;
---
<!doctype html>
<html lang="en"><head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><SeoHead title={pageTitle} description={project.summary} path={`/projects/${project.slug}/`} type="article" /><link rel="stylesheet" href="/assets/styles/main.css" /></head>
<body><header class="site-header page-shell"><div class="topbar"><a class="brand" href="/" aria-label="MattMcG / Lethal Coffee home">MattMcG / Lethal Coffee</a><nav class="top-links" aria-label="Primary"><a href="/about/">About</a><a href="/projects/" aria-current="page">Projects</a><a href="/#ventures">Ventures</a><a href="/connect/">Connect</a><a href="https://app.reclaim.ai/m/nullornan/lets-talk" target="_blank" rel="noopener noreferrer">Book a free call</a></nav></div></header>
<main class="page-shell project-detail"><a class="back-link" href="/projects/">All case studies</a><article><header class="project-hero"><p class="eyebrow">{project.number} · {project.eyebrow}</p><h1>{project.title}</h1><p>{project.summary}</p><div class="project-meta"><div><span>Outcome</span><strong>{project.outcome}</strong></div><div><span>Context</span><strong>{project.period}</strong></div><div><span>Role</span><strong>{project.role}</strong></div></div></header><div class="project-body"><section><p class="section-kicker">The challenge</p><h2>Here's what I walked into.</h2><p>{project.challenge}</p></section><section><p class="section-kicker">The approach</p><ol class="approach-list">{project.approach.map((step, index) => <li><span>{String(index + 1).padStart(2, "0")}</span>{step}</li>)}</ol></section><section class="results-panel"><p class="section-kicker">What changed</p><ul>{project.results.map((result) => <li>{result}</li>)}</ul><div class="tag-row">{project.stack.map((item) => <span>{item}</span>)}</div></section></div></article><section class="closing" aria-label="Work with Matt"><h2>Have a problem like this?</h2><div class="hero-actions"><a class="button button-primary" href="https://app.reclaim.ai/m/nullornan/lets-talk" target="_blank" rel="noopener noreferrer">Book a free 30-minute call -&gt;</a><a class="text-link" href="https://nullornan.com" target="_blank" rel="noopener noreferrer">Work with NullorNaN -&gt;</a></div></section></main>
<footer class="site-footer page-shell"><p>Matt McGowan · 2026 · Atlanta Metro / US Southeast</p><div><a href="https://nullornan.com" target="_blank" rel="noopener noreferrer">nullornan.com</a><a href="https://www.linkedin.com/in/matthewcmcgowan" target="_blank" rel="noopener noreferrer">LinkedIn</a><a href="https://github.com/NullOrNaN" target="_blank" rel="noopener noreferrer">GitHub</a><a href="https://reliabilitylounge.com" target="_blank" rel="noopener noreferrer">Reliability Lounge</a><a href="https://app.reclaim.ai/m/nullornan/lets-talk" target="_blank" rel="noopener noreferrer">Book a free 30-minute call</a></div></footer></body></html>
