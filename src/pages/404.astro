---
import SeoHead from "../components/SeoHead.astro";
const pageTitle = "Page not found | Matt McGowan";
const pageDescription = "That page is not here. Head back to the home page or connect with Matt McGowan.";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <SeoHead title={pageTitle} description={pageDescription} path="/404/" />
    <link rel="stylesheet" href="/assets/styles/main.css" />
  </head>
  <body>
    <header class="site-header page-shell">
      <div class="topbar">
        <a class="brand" href="/" aria-label="MattMcG / Lethal Coffee home">MattMcG / Lethal Coffee</a>
        <nav class="top-links" aria-label="Primary">
          <a href="/about/">About</a>
          <a href="/projects/">Projects</a>
          <a href="/#products">Products</a>
          <a href="/#ventures">Ventures</a>
          <a href="/connect/">Connect</a>
        </nav>
      </div>
    </header>

    <main class="page-shell about-wrap">
      <p class="eyebrow">404</p>
      <h1 class="about-title">This page is not here.</h1>
      <p class="connect-sub">The link may be old or mistyped. Try the home page, case studies, or connect routes.</p>
      <div class="hero-actions">
        <a class="button button-primary" href="/">Back to home</a>
        <a class="text-link" href="/connect/">Connect</a>
      </div>
    </main>

    <footer class="site-footer page-shell">
      <p>Matt McGowan · 2026 · Atlanta Metro / US Southeast</p>
      <div>
        <a href="https://nullornan.com" target="_blank" rel="noopener noreferrer">nullornan.com</a>
        <a href="https://www.linkedin.com/in/matthewcmcgowan" target="_blank" rel="noopener noreferrer">LinkedIn</a>
      </div>
    </footer>
  </body>
</html>
