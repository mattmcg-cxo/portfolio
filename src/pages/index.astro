---
import ResponsiveImage from "../components/ResponsiveImage.astro";
import SeoHead from "../components/SeoHead.astro";
import { projects } from "../data/projects";

const ventures = [
  { name: "NullorNaN Systems", role: "Founder & Chief Technology Officer", body: "A practice for fractional CTO and C2C engineering engagements, and the SaaS products NullSig, NullCard and NullPortal, a control panel for fractional leaders first built for our own use. NullorNaN offers fractional CTO and CIO leadership through Null CXO, hands-on engineering through Null Engineer, and engineering advisory through Null Advisory. Since 2026.", url: "https://nullornan.com", image: "nullornan.svg" },
  { name: "OUR+'R Technologies", role: "Co-Founder, CTO/COO, now advisory", body: "A driver-first rideshare platform that started as a NullorNaN advisory client and offered me a co-founder seat. As Chief Technology & Operations Officer from June to November 2026, I took product and engineering from concept to a working MVP in one week and cut build time 60% by moving the platform to Kubernetes. I'm now mostly advisory, by choice.", url: "https://getride.plus", image: "ourr.png" }
];

// Verified word for word from public LinkedIn recommendations (Profile & Career). Never reword.
const testimonials = [
  { quote: "Matthew was able to fix in 15 minutes what several others were unable to solve in weeks.", name: "Dani Perteet", title: "Founder", company: "Speedmax", source: "LinkedIn recommendation" },
  { quote: "If you are looking for an executive who leads with integrity, data-backed logic, and a zero-downtime mentality, Matthew is the gold standard.", name: "Clayton Hill, MBA", title: "Founder and CEO", company: "OUR+'R Technologies, Inc.", source: "LinkedIn recommendation" }
];

const faqs = [
  { question: "Who is Matt McGowan?", answer: "Matthew (Matt) McGowan is an infrastructure, SRE, and platform leader running $10M+ programs and production systems, from federal platforms to multi-tenant SaaS on Azure and AWS. He is the Founder & Chief Technology Officer of NullorNaN Systems and an executive advisor. He is based in Atlanta Metro / US Southeast and works with clients remotely across the US." },
  { question: "What roles does Matt McGowan fill?", answer: "Matt works across CTO, CIO and tech-focused COO responsibilities. He serves as a fractional CTO and CIO through NullorNaN's Null CXO plans, which cover CTO, CIO, CISO or COO seats. Through NullorNaN he also leads hands-on engineering and gives engineering advisory." },
  { question: "How can I work with Matt McGowan?", answer: "Matt is open to Director-and-above leadership roles where he stays hands-on, or senior technical roles at Staff and Principal level. He also takes select fractional CTO and C2C work through NullorNaN Systems. For fractional or advisory work, start at NullorNaN or book a free 30-minute call. For full-time roles or a direct connection, connect with Matt on LinkedIn." },
  { question: "Is Matt McGowan a fractional CTO?", answer: "Yes. Matt works as a fractional CTO and CIO through NullorNaN Systems, the company he founded. Before NullorNaN, he took freelance fractional CTO and CIO engagements through December 2025. He formed the LLC in 2026 and has run it full-time since March 2026. Engagement details are on nullornan.com." }
];
---
<!doctype html>
<html lang="en"><head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><SeoHead title="Matt McGowan | Principal Engineer and CTO | NullorNaN" description="Matthew (Matt) McGowan is an infrastructure, SRE, and platform leader in Atlanta Metro / US Southeast running $10M+ programs and production systems, from federal platforms to multi-tenant SaaS." path="/" faqs={faqs} /><link rel="stylesheet" href="/assets/styles/main.css" /></head>
<body><div class="site-atmosphere" aria-hidden="true"><span></span><span></span><span></span></div><header class="site-header page-shell"><div class="topbar"><a class="brand" href="/" aria-label="MattMcG / Lethal Coffee home">MattMcG / Lethal Coffee</a><nav class="top-links" aria-label="Primary"><a href="/about/">About</a><a href="/projects/">Projects</a><a href="#ventures">Ventures</a><a href="/connect/">Connect</a><a href="https://app.reclaim.ai/m/nullornan/lets-talk" target="_blank" rel="noopener noreferrer">Book a free call</a></nav></div></header>
<nav class="section-nav" aria-label="Section navigation"><div class="section-nav-controls"><button type="button" data-section-prev aria-label="Previous section" disabled>Up</button><button type="button" data-section-next aria-label="Next section">Down</button></div><span class="section-nav-label" id="section-label">Intro</span><p class="sr-only" id="section-status" aria-live="polite">Current section: Intro. Use the up and down arrow keys to navigate.</p></nav>
<main><section id="intro" data-section="Intro" class="landing page-shell" aria-labelledby="hero-title"><div class="hero-grid"><div class="hero-copy"><p class="eyebrow">Matt McGowan · Founder &amp; Chief Technology Officer, NullorNaN Systems</p><h1 id="hero-title">Real results from Infra to leadership.</h1><p class="hero-body">Infrastructure, SRE, and platform leader running $10M+ programs and production systems, from federal platforms to multi-tenant SaaS on Azure and AWS. I find what's actually broken in infrastructure, teams, and process, fix it, and explain it in plain English.</p><p class="hero-availability">Outage recovery time cut 75%. $10M+ DoD program. 50+ people led, including vendor teams. Based in Atlanta Metro / US Southeast, working remotely across the US. Open to Director-and-above leadership roles where I stay hands-on, or senior technical roles at Staff and Principal level, plus select fractional CTO and C2C work through NullorNaN Systems.</p><p class="hero-note"><strong>Lethal Coffee</strong> is the nickname that stuck. I take the work seriously, not myself.</p><div class="hero-actions"><a class="button button-primary" href="https://app.reclaim.ai/m/nullornan/lets-talk" target="_blank" rel="noopener noreferrer">Book a free 30-minute call</a><a class="text-link" href="https://nullornan.com" target="_blank" rel="noopener noreferrer">Work with NullorNaN</a><a class="text-link" href="/projects/">See case studies</a></div></div><div class="hero-portrait-wrap"><div class="portrait-orbit orbit-one" aria-hidden="true"></div><div class="portrait-orbit orbit-two" aria-hidden="true"></div><ResponsiveImage class="hero-profile" base="/assets/images/profile2/profile2" widths={[160, 200, 320, 400]} sizes="(max-width: 700px) 210px, 320px" alt="Matt McGowan, Founder &amp; Chief Technology Officer of NullorNaN Systems" width={320} height={320} loading="eager" /><p class="portrait-caption">Build. Lead. Scale. Fix.</p></div></div><a class="scroll-prompt" href="#work">Scroll to see the work</a></section>
<section id="work" data-section="Selected work" class="work-reel page-shell" aria-labelledby="work-title"><div class="section-heading split-heading"><div><p class="section-kicker">Selected work</p><h2 id="work-title">Measured in outcomes,<br />not noise.</h2></div><p>Results from client engagements and operating roles: AI governance, maintenance windows, incident response and scale. Each case study covers the problem, the approach and what changed.</p></div><div class="work-stack">{projects.map((project) => <a class="work-card" href={`/projects/${project.slug}/`}><span class="project-number">{project.number}</span><div><p>{project.eyebrow}</p><h3>{project.title}</h3></div><strong>{project.outcome}</strong></a>)}</div><div class="leadership-snapshot" aria-label="Leadership experience"><div><strong>75%</strong><span>faster outage recovery, 60 to 15 minutes</span></div><div><strong>50+</strong><span>people led, including vendor teams</span></div><div><strong>$10M+</strong><span>in programs delivered</span></div></div></section>
<section id="testimonials" data-section="What people say" class="faq-band page-shell" aria-labelledby="testimonials-title"><p class="section-kicker">From LinkedIn recommendations</p><h2 id="testimonials-title">In their words.</h2><div class="faq-list">{testimonials.map((t) => <figure><blockquote><p>"{t.quote}"</p></blockquote><figcaption>{t.name}, {t.title}, {t.company} ({t.source})</figcaption></figure>)}</div></section>
<section id="ventures" data-section="Ventures" class="ventures-band" aria-labelledby="ventures-title"><div class="page-shell"><div class="section-heading split-heading"><div><p class="section-kicker">In motion</p><h2 id="ventures-title">Two companies.<br />Distinct jobs.</h2></div><p>A fractional technology practice with its own SaaS products, and a rideshare startup where I hold a co-founder seat and now advise.</p></div><div class="venture-grid">{ventures.map((venture) => <a class="venture-card" href={venture.url} target="_blank" rel="noopener noreferrer"><div class="venture-brand"><img src={`/assets/images/${venture.image}`} alt="" aria-hidden="true" width={32} height={32} /><span>{venture.role}</span></div><h3>{venture.name}</h3><p>{venture.body}</p><span class="text-link">Visit site</span></a>)}</div></div></section>
<section id="answers" data-section="Quick answers" class="faq-band page-shell" aria-labelledby="faq-title"><p class="section-kicker">For founders, executives and recruiters</p><h2 id="faq-title">The short version.</h2><div class="faq-list">{faqs.map((faq, index) => <details><summary>{faq.question}</summary>{index === 2 ? <p>Matt is open to Director-and-above leadership roles where he stays hands-on, or senior technical roles at Staff and Principal level. He also takes select fractional CTO and C2C work through NullorNaN Systems. For fractional or advisory work, start at <a href="https://nullornan.com" target="_blank" rel="noopener noreferrer">NullorNaN</a> or <a href="https://app.reclaim.ai/m/nullornan/lets-talk" target="_blank" rel="noopener noreferrer">book a free 30-minute call</a>. For full-time roles or a direct connection, connect with Matt on <a href="https://www.linkedin.com/in/matthewcmcgowan" target="_blank" rel="noopener noreferrer">LinkedIn</a>.</p> : <p>{faq.answer}</p>}</details>)}</div></section>
<section id="contact" data-section="Contact" class="closing page-shell" aria-labelledby="closing-title"><p class="section-kicker">Executive technical leadership</p><h2 id="closing-title">Need ownership for a hard technical problem?</h2><p>I lead engineering at NullorNaN, take fractional CTO and CIO engagements, lead hands-on engineering when the work needs it, and give engineering advisory on bounded technical questions. I'm open to Director-and-above leadership roles where I stay hands-on, or senior technical roles at Staff and Principal level.</p><div class="hero-actions"><a class="button button-primary" href="https://app.reclaim.ai/m/nullornan/lets-talk" target="_blank" rel="noopener noreferrer">Book a free 30-minute call</a><a class="text-link" href="https://nullornan.com" target="_blank" rel="noopener noreferrer">Work with NullorNaN</a><a class="text-link" href="https://www.linkedin.com/in/matthewcmcgowan" target="_blank" rel="noopener noreferrer">Connect on LinkedIn</a></div></section></main>
<footer class="site-footer page-shell"><p>Matt McGowan · 2026 · Atlanta Metro / US Southeast</p><div><a href="https://nullornan.com" target="_blank" rel="noopener noreferrer">nullornan.com</a><a href="https://www.linkedin.com/in/matthewcmcgowan" target="_blank" rel="noopener noreferrer">LinkedIn</a><a href="https://github.com/NullOrNaN" target="_blank" rel="noopener noreferrer">GitHub</a><a href="https://app.reclaim.ai/m/nullornan/lets-talk" target="_blank" rel="noopener noreferrer">Book a free 30-minute call</a></div></footer>
<script>
  const sections = [...document.querySelectorAll("[data-section]")];
  const previous = document.querySelector("[data-section-prev]");
  const next = document.querySelector("[data-section-next]");
  const label = document.querySelector("#section-label");
  const status = document.querySelector("#section-status");
  let currentIndex = 0;

  const setCurrentSection = (index, announce = false) => {
    currentIndex = Math.max(0, Math.min(index, sections.length - 1));
    label.textContent = sections[currentIndex].dataset.section;
    previous.disabled = currentIndex === 0;
    next.disabled = currentIndex === sections.length - 1;
    if (announce) status.textContent = `Current section: ${sections[currentIndex].dataset.section}.`;
  };

  const goToSection = (index) => {
    setCurrentSection(index, true);
    sections[currentIndex].scrollIntoView({ behavior: "smooth", block: "start" });
  };

  previous.addEventListener("click", () => goToSection(currentIndex - 1));
  next.addEventListener("click", () => goToSection(currentIndex + 1));
  new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (entry.isIntersecting) setCurrentSection(sections.indexOf(entry.target));
    });
  }, { rootMargin: "-35% 0px -55%", threshold: 0 }).observe(sections[0]);
  sections.slice(1).forEach((section) => new IntersectionObserver((entries) => {
    if (entries[0].isIntersecting) setCurrentSection(sections.indexOf(section));
  }, { rootMargin: "-35% 0px -55%", threshold: 0 }).observe(section));

  document.addEventListener("keydown", (event) => {
    const target = event.target;
    if (target instanceof HTMLElement && (target.isContentEditable || ["INPUT", "TEXTAREA", "SELECT", "BUTTON", "A"].includes(target.tagName))) return;
    if (["ArrowDown", "PageDown"].includes(event.key)) { event.preventDefault(); goToSection(currentIndex + 1); }
    if (["ArrowUp", "PageUp"].includes(event.key)) { event.preventDefault(); goToSection(currentIndex - 1); }
    if (event.key === "Home") { event.preventDefault(); goToSection(0); }
    if (event.key === "End") { event.preventDefault(); goToSection(sections.length - 1); }
  });
</script></body></html>
