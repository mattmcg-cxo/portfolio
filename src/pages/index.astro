---
import ResponsiveImage from "../components/ResponsiveImage.astro";
import SeoHead from "../components/SeoHead.astro";
import { projects } from "../data/projects";

const ventures = [
  { name: "NullorNaN Systems", role: "Founder and CTO", body: "Fractional CTO and CIO leadership through NullCXO, hands-on engineering through Null Engineer and engineering advisory through Null Advisory. Since 2021.", url: "https://nullornan.com", image: "nullornan.svg" },
  { name: "OUR+'R Technologies", role: "Co-founder and CTO/COO", body: "Co-founded in June 2026. I took the product from concept to MVP and cut build time 60%.", url: "https://getride.plus", image: "ourr.png" },
  { name: "Reliability Lounge", role: "Founder", body: "A free, open-source SRE community for people who run production systems.", url: "https://reliabilitylounge.com", image: "rl.png" }
];

// Verified word for word from public LinkedIn recommendations (Profile & Career). Never reword.
const testimonials = [
  { quote: "Matthew was able to fix in 15 minutes what several others were unable to solve in weeks.", name: "Dani Perteet", title: "Founder", company: "SpeedMax LLC", source: "LinkedIn recommendation" },
  { quote: "If you are looking for an executive who leads with integrity, data-backed logic, and a zero-downtime mentality, Matthew is the gold standard.", name: "Clayton Hill, MBA", title: "Founder and CEO", company: "OUR+'R Technologies, Inc.", source: "LinkedIn recommendation" }
];

const faqs = [
  { question: "Who is Matt McGowan?", answer: "Matthew (Matt) McGowan is the Founder and CTO of NullorNaN Systems and co-founder and CTO/COO of OUR+'R Technologies. He is a CTO, executive advisor and 3x founder with 20+ years building software and systems. He is based in Atlanta Metro / US Southeast and works with clients remotely across the US." },
  { question: "What roles does Matt McGowan fill?", answer: "Matt works across CTO, CIO and tech-focused COO responsibilities. He serves as a fractional CTO and CIO through NullorNaN's NullCXO plans, which cover CTO, CIO, CISO or COO seats. Through NullorNaN he also leads hands-on engineering (Null Engineer) and engineering advisory (Null Advisory)." },
  { question: "How can I work with Matt McGowan?", answer: "Fractional and advisory work runs through NullorNaN, and Matt is open to the right full-time role. Start at nullornan.com or book a free 30-minute call. For full-time roles or a direct connection, connect with Matt on LinkedIn." },
  { question: "Is Matt McGowan a fractional CTO?", answer: "Yes. Matt works as a fractional CTO and CIO through NullorNaN Systems, the company he founded. He started fractional CTO work in 2021, formed the LLC in 2026 and has run it full-time since March 2026. Engagement details are on nullornan.com." }
];
---
<!doctype html>
<html lang="en"><head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><SeoHead title="Matt McGowan | Founder and CTO, Fractional CTO and CIO" description="Matthew (Matt) McGowan is a Founder and CTO and a fractional CTO and CIO in Atlanta Metro / US Southeast, with 20+ years building and running systems." path="/" faqs={faqs} /><link rel="stylesheet" href="/assets/styles/main.css" /></head>
<body><div class="site-atmosphere" aria-hidden="true"><span></span><span></span><span></span></div><header class="site-header page-shell"><div class="topbar"><a class="brand" href="/" aria-label="MattMcG / Lethal Coffee home">MattMcG / Lethal Coffee</a><nav class="top-links" aria-label="Primary"><a href="/about/">About</a><a href="/projects/">Projects</a><a href="#ventures">Ventures</a><a href="/connect/">Connect</a><a href="https://app.reclaim.ai/m/nullornan/lets-talk" target="_blank" rel="noopener noreferrer">Book a free call</a></nav></div></header>
<nav class="section-nav" aria-label="Section navigation"><div class="section-nav-controls"><button type="button" data-section-prev aria-label="Previous section" disabled>Up</button><button type="button" data-section-next aria-label="Next section">Down</button></div><span class="section-nav-label" id="section-label">Intro</span><p class="sr-only" id="section-status" aria-live="polite">Current section: Intro. Use the up and down arrow keys to navigate.</p></nav>
<main><section id="intro" data-section="Intro" class="landing page-shell" aria-labelledby="hero-title"><div class="hero-grid"><div class="hero-copy"><p class="eyebrow">Matt McGowan · Founder and CTO, NullorNaN Systems</p><h1 id="hero-title">Engineers call me the Systems Whisperer. My friends call me Mr. Koffee. My govie friends call me Mr. McG.</h1><p class="hero-body">I turn complicated technology into business results (and plain English).</p><p class="hero-availability">Founder and CTO of NullorNaN Systems and co-founder and CTO/COO of OUR+'R Technologies, with 20+ years across software, platforms and regulated infrastructure. Based in Atlanta Metro / US Southeast, working with clients remotely across the US. Fractional and advisory work runs through NullorNaN, and I'm open to the right full-time role.</p><p class="hero-note">If you came here from <strong>lethal.coffee</strong>, you're in the right place. I take the work seriously, not myself.</p><div class="hero-actions"><a class="button button-primary" href="https://app.reclaim.ai/m/nullornan/lets-talk" target="_blank" rel="noopener noreferrer">Book a free 30-minute call -&gt;</a><a class="text-link" href="https://nullornan.com" target="_blank" rel="noopener noreferrer">Work with NullorNaN -&gt;</a><a class="text-link" href="/projects/">See case studies -&gt;</a></div></div><div class="hero-portrait-wrap"><div class="portrait-orbit orbit-one" aria-hidden="true"></div><div class="portrait-orbit orbit-two" aria-hidden="true"></div><ResponsiveImage class="hero-profile" base="/assets/images/profile2/profile2" widths={[160, 200, 320, 400]} sizes="(max-width: 700px) 210px, 320px" alt="Matt McGowan, Founder and CTO of NullorNaN Systems" width={320} height={320} loading="eager" /><p class="portrait-caption">Build. Lead. Scale. Fix.</p></div></div><a class="scroll-prompt" href="#work">Scroll to see the work</a></section>
<section id="work" data-section="Selected work" class="work-reel page-shell" aria-labelledby="work-title"><div class="section-heading split-heading"><div><p class="section-kicker">Selected work</p><h2 id="work-title">Measured in outcomes,<br />not noise.</h2></div><p>Results from client engagements and operating roles: AI spend, maintenance windows, incident response and scale. Each case study covers the problem, the approach and what changed.</p></div><div class="work-stack">{projects.map((project) => <a class="work-card" href={`/projects/${project.slug}/`}><span class="project-number">{project.number}</span><div><p>{project.eyebrow}</p><h3>{project.title}</h3></div><strong>{project.outcome}</strong></a>)}</div><div class="leadership-snapshot" aria-label="Leadership experience"><div><strong>20+</strong><span>years building and running systems</span></div><div><strong>50+</strong><span>people led, including vendor teams</span></div><div><strong>$10M+</strong><span>in programs delivered</span></div></div></section>
<section id="testimonials" data-section="What people say" class="faq-band page-shell" aria-labelledby="testimonials-title"><p class="section-kicker">From LinkedIn recommendations</p><h2 id="testimonials-title">In their words.</h2><div class="faq-list">{testimonials.map((t) => <figure><blockquote><p>"{t.quote}"</p></blockquote><figcaption>{t.name}, {t.title}, {t.company} ({t.source})</figcaption></figure>)}</div></section>
<section id="ventures" data-section="Ventures" class="ventures-band" aria-labelledby="ventures-title"><div class="page-shell"><div class="section-heading split-heading"><div><p class="section-kicker">In motion</p><h2 id="ventures-title">Three ventures.<br />Three different jobs.</h2></div><p>A fractional technology practice, a SaaS company I co-founded and a free community for people who run production systems.</p></div><div class="venture-grid">{ventures.map((venture) => <a class="venture-card" href={venture.url} target="_blank" rel="noopener noreferrer"><div class="venture-brand"><img src={`/assets/images/${venture.image}`} alt="" aria-hidden="true" width={32} height={32} /><span>{venture.role}</span></div><h3>{venture.name}</h3><p>{venture.body}</p><span class="text-link">Visit site</span></a>)}</div></div></section>
<section id="answers" data-section="Quick answers" class="faq-band page-shell" aria-labelledby="faq-title"><p class="section-kicker">For founders, executives and recruiters</p><h2 id="faq-title">The short version.</h2><div class="faq-list">{faqs.map((faq, index) => <details><summary>{faq.question}</summary>{index === 2 ? <p>Fractional and advisory work runs through NullorNaN, and Matt is open to the right full-time role. Start at <a href="https://nullornan.com" target="_blank" rel="noopener noreferrer">nullornan.com</a> or <a href="https://app.reclaim.ai/m/nullornan/lets-talk" target="_blank" rel="noopener noreferrer">book a free 30-minute call</a>. For full-time roles or a direct connection, connect with Matt on <a href="https://www.linkedin.com/in/matthewcmcgowan" target="_blank" rel="noopener noreferrer">LinkedIn</a>.</p> : <p>{faq.answer}</p>}</details>)}</div></section>
<section id="contact" data-section="Contact" class="closing page-shell" aria-labelledby="closing-title"><p class="section-kicker">Executive technical leadership</p><h2 id="closing-title">Got a hard technical problem nobody owns?</h2><p>I work as a fractional CTO and CIO through NullorNaN, lead hands-on engineering when the work needs it and advise on bounded technical questions. Fractional and advisory work runs through NullorNaN, and I'm open to the right full-time role.</p><div class="hero-actions"><a class="button button-primary" href="https://app.reclaim.ai/m/nullornan/lets-talk" target="_blank" rel="noopener noreferrer">Book a free 30-minute call -&gt;</a><a class="text-link" href="https://nullornan.com" target="_blank" rel="noopener noreferrer">Work with NullorNaN -&gt;</a><a class="text-link" href="https://www.linkedin.com/in/matthewcmcgowan" target="_blank" rel="noopener noreferrer">Connect on LinkedIn -&gt;</a></div></section></main>
<footer class="site-footer page-shell"><p>Matt McGowan · 2026 · Atlanta Metro / US Southeast</p><div><a href="https://nullornan.com" target="_blank" rel="noopener noreferrer">nullornan.com</a><a href="https://www.linkedin.com/in/matthewcmcgowan" target="_blank" rel="noopener noreferrer">LinkedIn</a><a href="https://github.com/NullOrNaN" target="_blank" rel="noopener noreferrer">GitHub</a><a href="https://reliabilitylounge.com" target="_blank" rel="noopener noreferrer">Reliability Lounge</a><a href="https://app.reclaim.ai/m/nullornan/lets-talk" target="_blank" rel="noopener noreferrer">Book a free 30-minute call</a></div></footer>
<script>
  const sections = [...document.querySelectorAll("[data-section]")];
  const previous = document.querySelector("[data-section-prev]");
  const next = document.querySelector("[data-section-next]");
  const label = document.querySelector("#section-label");
  const status = document.querySelector("#section-status");
  let currentIndex = 0;

  const setCurrentSection = (index, announce = false) => {
    currentIndex = Math.max(0, Math.min(index, sections.length - 1));
    label.textContent = sections[currentIndex].dataset.section;
    previous.disabled = currentIndex === 0;
    next.disabled = currentIndex === sections.length - 1;
    if (announce) status.textContent = `Current section: ${sections[currentIndex].dataset.section}.`;
  };

  const goToSection = (index) => {
    setCurrentSection(index, true);
    sections[currentIndex].scrollIntoView({ behavior: "smooth", block: "start" });
  };

  previous.addEventListener("click", () => goToSection(currentIndex - 1));
  next.addEventListener("click", () => goToSection(currentIndex + 1));
  new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (entry.isIntersecting) setCurrentSection(sections.indexOf(entry.target));
    });
  }, { rootMargin: "-35% 0px -55%", threshold: 0 }).observe(sections[0]);
  sections.slice(1).forEach((section) => new IntersectionObserver((entries) => {
    if (entries[0].isIntersecting) setCurrentSection(sections.indexOf(section));
  }, { rootMargin: "-35% 0px -55%", threshold: 0 }).observe(section));

  document.addEventListener("keydown", (event) => {
    const target = event.target;
    if (target instanceof HTMLElement && (target.isContentEditable || ["INPUT", "TEXTAREA", "SELECT", "BUTTON", "A"].includes(target.tagName))) return;
    if (["ArrowDown", "PageDown"].includes(event.key)) { event.preventDefault(); goToSection(currentIndex + 1); }
    if (["ArrowUp", "PageUp"].includes(event.key)) { event.preventDefault(); goToSection(currentIndex - 1); }
    if (event.key === "Home") { event.preventDefault(); goToSection(0); }
    if (event.key === "End") { event.preventDefault(); goToSection(sections.length - 1); }
  });
</script></body></html>
