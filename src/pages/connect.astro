---
import SeoHead from "../components/SeoHead.astro";
const pageTitle = "Contact Matt McGowan | Hire, Book a Call or Connect";
const pageDescription =
  "Work with Matt McGowan: fractional CTO and CIO leadership, hands-on engineering or engineering advisory through NullorNaN, or book a free 30-minute call.";

const routes = [
  {
    title: "Book a free 30-minute call",
    body: "The fastest way to start. Bring the problem, not a deck, and I will tell you honestly whether I can help.",
    url: "https://app.reclaim.ai/m/nullornan/lets-talk",
    cta: "Book a free 30-minute call"
  },
  {
    title: "Fractional CTO or CIO leadership (Null CXO)",
    body: "Fractional executive leadership for founders and SMB leaders through NullorNaN. Null CXO covers CTO, CIO, CISO or COO seats.",
    url: "https://nullornan.com/nullcxo/",
    cta: "nullornan.com/nullcxo"
  },
  {
    title: "Hands-on engineering (Null Engineer)",
    body: "Senior hands-on engineering across software, cloud, infrastructure and reliability, when the work needs someone in the code and the systems.",
    url: "https://nullornan.com/null-engineer/",
    cta: "nullornan.com/null-engineer"
  },
  {
    title: "Engineering advisory (Null Advisory)",
    body: "Engineering advisory on a bounded technical question, such as an architecture second opinion, an infrastructure review or a vendor review.",
    url: "https://nullornan.com/null-advisory/",
    cta: "nullornan.com/null-advisory"
  },
  {
    title: "Full-time roles and recruiters",
    body: "I'm open to Director-and-above leadership roles where I stay hands-on, or senior technical roles at Staff and Principal level. For full-time roles, connect with me on LinkedIn.",
    url: "https://www.linkedin.com/in/matthewcmcgowan",
    cta: "linkedin.com/in/matthewcmcgowan"
  },
  {
    title: "Direct connection",
    body: "Send a free LinkedIn InMail with your pitch, context, and the impact you want to create.",
    url: "https://www.linkedin.com/in/matthewcmcgowan",
    cta: "Send a LinkedIn InMail"
  },
  {
    title: "Code and technical projects",
    body: "GitHub: software, automation, infrastructure, and platform engineering work.",
    url: "https://github.com/NullOrNaN",
    cta: "github.com/NullOrNaN"
  }
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <SeoHead title={pageTitle} description={pageDescription} path="/connect/" pageType="ContactPage" />
    <link rel="stylesheet" href="/assets/styles/main.css" />
  </head>
  <body>
    <header class="site-header page-shell">
      <div class="topbar">
        <a class="brand" href="/" aria-label="MattMcG / Lethal Coffee home">MattMcG / Lethal Coffee</a>
        <nav class="top-links" aria-label="Primary">
          <a href="/about/">About</a>
          <a href="/projects/">Projects</a>
          <a href="/#ventures">Ventures</a>
          <a href="/connect/" aria-current="page">Connect</a>
          <a href="https://app.reclaim.ai/m/nullornan/lets-talk" target="_blank" rel="noopener noreferrer">Book a free call</a>
        </nav>
      </div>
    </header>

    <main class="page-shell">
      <section class="connect-hero">
        <p class="eyebrow">Matt McGowan</p>
        <h1 class="connect-title">Work with Matt McGowan.</h1>
        <p class="connect-sub">I'm open to Director-and-above leadership roles where I stay hands-on, or senior technical roles at Staff and Principal level. Select fractional CTO and C2C work runs through NullorNaN Systems. I'm based in Atlanta Metro / US Southeast and work with clients remotely across the US. Choose the route that fits.</p>
      </section>

      <section aria-label="Routing options">
        <ol class="connect-list" role="list">
          {routes.map((r, i) => (
            <li>
              <a class="connect-card" href={r.url} target="_blank" rel="noopener noreferrer">
                <span class="connect-num" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
                <span class="connect-body">
                  <span class="connect-title-row">{r.title}</span>
                  <span class="connect-desc">{r.body}</span>
                </span>
                <span class="connect-cta">{r.cta}</span>
              </a>
            </li>
          ))}
        </ol>
      </section>
    </main>

    <footer class="site-footer page-shell">
      <div class="footer-inner">
        <p class="footer-name">Matt McGowan</p>
        <nav class="footer-links" aria-label="External links">
          <a href="https://nullornan.com" target="_blank" rel="noopener noreferrer">nullornan.com</a>
          <a href="https://www.linkedin.com/in/matthewcmcgowan" target="_blank" rel="noopener noreferrer">LinkedIn</a>
          <a href="https://github.com/NullOrNaN" target="_blank" rel="noopener noreferrer">github.com/NullOrNaN</a>
          <a href="https://app.reclaim.ai/m/nullornan/lets-talk" target="_blank" rel="noopener noreferrer">Book a free 30-minute call</a>
        </nav>
        <p class="footer-copy">&copy; 2026 Matt McGowan · Atlanta Metro / US Southeast</p>
      </div>
    </footer>

    <!-- Cloudflare Web Analytics -->
    <script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "c1bd1d7c50244959b719cc3bbf367dbd"}'></script>
  </body>
</html>
